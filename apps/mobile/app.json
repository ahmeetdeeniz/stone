{
  "expo": {
    "name": "Stone",
    "slug": "stone",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "default",
    "scheme": "stone",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#2e0702",
    "androidStatusBar": {
      "backgroundColor": "#2e0702",
      "barStyle": "light-content"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.1"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imtempra.stone"
    },
    "android": {
      "package": "com.imtempra.stone",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2e0702"
      }
    },
    "assetBundlePatterns": ["**/*"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94c185f1-913f-41d0-a888-e06f04d2b279"
      }
    },
    "owner": "tt3mpra"
  }
}
