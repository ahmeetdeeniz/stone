{
  "name": "@stone/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "expo start --dev-client",
    "doctor": "expo-doctor",
    "preexport": "pnpm --filter @stone/domain --filter @stone/markdown --filter @stone/editor --filter @stone/sync --filter @stone/ink run typecheck",
    "export": "expo export --platform android --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-firebase/app": "^23.4.0",
    "@react-native-firebase/auth": "^23.4.0",
    "@react-native-firebase/firestore": "^23.4.0",
    "@react-native-firebase/storage": "^23.4.0",
    "@shopify/react-native-skia": "2.2.12",
    "@stone/domain": "workspace:*",
    "@stone/editor": "workspace:*",
    "@stone/ink": "workspace:*",
    "@stone/markdown": "workspace:*",
    "@stone/sync": "workspace:*",
    "expo": "^54.0.0",
    "expo-background-task": "~1.0.10",
    "expo-constants": "^18.0.0",
    "expo-crypto": "^15.0.0",
    "expo-dev-client": "^6.0.0",
    "expo-device": "^8.0.0",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-linking": "^8.0.0",
    "expo-router": "^6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "^16.0.0",
    "expo-status-bar": "^3.0.0",
    "expo-task-manager": "~14.0.9",
    "react": "19.1.0",
    "react-reconciler": "0.31.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "expo-doctor": "^1.20.1"
  }
}
