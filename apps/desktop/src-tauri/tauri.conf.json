{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stone",
  "version": "0.1.0",
  "identifier": "com.imtempra.stone.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @stone/desktop run dev",
    "beforeBuildCommand": "pnpm --filter @stone/desktop run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stone",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.googleapis.com https://securetoken.googleapis.com https://identitytoolkit.googleapis.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Stone contributors",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
