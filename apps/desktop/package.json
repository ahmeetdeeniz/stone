{
  "name": "@stone/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "pretest": "pnpm --filter @stone/domain --filter @stone/markdown --filter @stone/editor --filter @stone/sync --filter @stone/i18n run typecheck",
    "test": "vitest run src",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "tauri:build:macos": "tauri build --bundles app,dmg --target universal-apple-darwin",
    "tauri:build:linux": "tauri build --bundles deb,appimage"
  },
  "dependencies": {
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@stone/domain": "workspace:*",
    "@stone/editor": "workspace:*",
    "@stone/i18n": "workspace:*",
    "@stone/markdown": "workspace:*",
    "@stone/sync": "workspace:*",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
