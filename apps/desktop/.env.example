# Copy this file to apps/desktop/.env.local and fill in your own values.
# apps/desktop/.env.local is ignored by Git and consumed by Vite for local
# desktop development (see apps/desktop/vite.config.ts). Never commit real values.

# Desktop-only public GitHub OAuth App client ID. Enable Device Flow in the OAuth App.
VITE_GITHUB_CLIENT_ID=

# Your own Firebase project's Web app configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
