# Mobile public Firebase client identifiers. Copy to the repository-root .env.
# All six values are required unless app.config.ts can read them from your ignored
# apps/mobile/google-services.json. These identify a client; they are not service credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=replace-with-your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-with-your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-your-mobile-app-id

# Desktop values belong in apps/desktop/.env.local using apps/desktop/.env.example.
# MCP server values belong in services/mcp/.env using services/mcp/.env.example.
# Never put service accounts, OAuth secrets/tokens, signing keys, or real user data here.
