{
  "name": "stone",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm typecheck && eslint .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rules": "firebase emulators:exec --project demo-stone --only firestore \"pnpm vitest run --config vitest.rules.config.ts\"",
    "test:storage-rules": "firebase emulators:exec --project demo-stone --only storage \"pnpm vitest run firebase/storage.rules.test.ts\"",
    "expo": "pnpm --filter @stone/mobile run start",
    "expo:doctor": "pnpm --filter @stone/mobile run doctor",
    "mobile": "pnpm --filter @stone/mobile run export",
    "mobile:export": "pnpm --filter @stone/mobile run export",
    "desktop:dev": "pnpm --filter @stone/desktop run tauri:dev",
    "desktop:build": "pnpm --filter @stone/desktop run build",
    "desktop:typecheck": "pnpm --filter @stone/desktop run typecheck",
    "desktop:test": "pnpm --filter @stone/desktop run test",
    "desktop:tauri:build": "pnpm --filter @stone/desktop run tauri:build",
    "desktop:tauri:build:nsis": "pnpm --filter @stone/desktop run tauri:build:nsis",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "report:desktop-build-env": "node scripts/report-desktop-build-env.mjs",
    "verify:github": "node scripts/verify-github-desktop.mjs",
    "verify:github:live": "node scripts/verify-github-live.mjs",
    "verify:public-boundary": "node scripts/verify-public-boundary.mjs",
    "verify:clean-workspace": "node scripts/verify-clean-workspace.mjs",
    "editor:bundle": "pnpm --filter @stone/editor run build:web",
    "verify:native-dependencies": "node scripts/verify-native-dependencies.mjs",
    "mcp:typecheck": "pnpm --filter @stone/mcp run typecheck",
    "mcp:build": "pnpm --filter @stone/mcp run build",
    "mcp:start": "pnpm --filter @stone/mcp run start",
    "mcp:dev": "pnpm --filter @stone/mcp run dev",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "eas:android:development": "pnpm --dir apps/mobile exec eas build --platform android --profile development",
    "eas:ios:simulator": "pnpm --dir apps/mobile exec eas build --platform ios --profile development-simulator",
    "mobile:android": "pnpm --filter @stone/mobile run android",
    "mobile:ios": "pnpm --filter @stone/mobile run ios"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "firebase": "^12.10.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.2"
  }
}
