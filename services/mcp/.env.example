# Copy to services/mcp/.env only in a private local/deployment environment.
# Required Firebase project/server configuration:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_WEB_API_KEY=replace-with-your-public-web-api-key

# Choose Application Default Credentials or provide a complete service-account JSON value through
# your deployment secret manager. Never commit the real JSON or place it in a client-side env file.
FIREBASE_SERVICE_ACCOUNT_JSON=replace-through-a-secret-manager

# Required public deployment identity:
MCP_RESOURCE_URL=https://mcp.example.com
MCP_OAUTH_ISSUER=https://mcp.example.com/oauth

# Required server secrets/keys. Generate privately; placeholders are intentionally unusable.
MCP_OAUTH_PRIVATE_KEY=replace-through-a-secret-manager
MCP_OAUTH_PUBLIC_KEY=replace-with-the-matching-public-key
MCP_OAUTH_KEY_ID=stone-mcp-1
MCP_CURSOR_SECRET=replace-with-a-long-random-secret
MCP_ALLOWED_REDIRECT_URIS=https://replace-with-an-exact-client-callback.example

# Optional:
PORT=8787
# MCP_USE_MEMORY_STORE=true is development-only and must not be used for durable deployment.

